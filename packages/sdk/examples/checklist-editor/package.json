{
  "name": "@multichamber/example-checklist-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@multichamber/sdk": "workspace:*"
  },
  "multichamber": {
    "apiVersion": 1,
    "contributes": {
      "panel": {
        "id": "checklist-editor",
        "name": "Checklist",
        "icon": "list-check-2"
      },
      "fileEditors": [
        {
          "id": "checklist",
          "title": "Checklist",
          "match": [
            "*.checklist.md"
          ],
          "entry": "editor/index.html"
        }
      ]
    }
  }
}
