{
  "name": "@multichamber/example-github-token",
  "version": "1.1.0",
  "private": true,
  "dependencies": {
    "@multichamber/sdk": "workspace:*"
  },
  "multichamber": {
    "apiVersion": 1,
    "contributes": {
      "panel": {
        "id": "github-token",
        "name": "Repository Explorer",
        "icon": "github",
        "entry": "panel/index.html"
      },
      "attach": "panel",
      "page": true,
      "integration": {
        "name": "GitHub (token)",
        "description": "Lists your repositories with a personal access token.",
        "token": {
          "apiOrigin": "https://api.github.com",
          "account": {
            "path": "/user",
            "name": "login"
          },
          "scheme": "bearer"
        },
        "settings": [
          {
            "id": "visibility",
            "label": "Visibility (all, public, private)"
          }
        ]
      }
    }
  }
}
