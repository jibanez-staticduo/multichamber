{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@multichamber/sdk": ["./src/index.ts"],
      "@multichamber/sdk/ui": ["./src/ui/index.ts"]
    }
  },
  "include": ["src", "examples/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
